@* API from: https://www.datamuse.com/api/ *@
@* Attepmts to call GetSynonmysAsync from SynonymServices.cs *@

@inject SynonymService Synonyms

<aside class="synonym-sidebar">
    <input @bind="_word" @bind:event="oninput" @bind:after="OnInput" placeholder="Enter a word" />
    @if (_loading) { <p>Loading...</p> 
    }
    <ul>@foreach (var synonym in _result) { <li>@synonym</li> }</ul>
</aside>

@code {
    private string _word = "";
    private List<string> _result = [];
    private bool _loading = false;
    private CancellationTokenSource? _cts;

    private async Task OnInput()
    {
        _cts?.Cancel();
        _cts = new CancellationTokenSource();
        var token = _cts.Token;
        try
        {
            await Task.Delay(300, token); // Debounce input
            _loading = true;
            _result = (await Synonyms.GetSynonymsAsync(_word, token)).ToList();
            _loading = false;
        }
        catch (OperationCanceledException)
        {
            // Ignore cancellation
        }
    }
}
